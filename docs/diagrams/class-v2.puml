@startuml class-v2
title CampusEvent 类图（v2 / change-v2）
!pragma layout smetana
skinparam classAttributeIconSize 0
hide empty members
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor<<new>> LightGreen
  BorderColor<<new>> Green
  BackgroundColor<<changed>> LightYellow
  BorderColor<<changed>> Orange
}

legend right
  绿色底 = v2 新增\n黄色底 = v2 变更
endlegend

package "领域模型 models" {
  class Student <<dataclass>> {
    +student_id: str
    +name: str
    +grade: int
  }
  class Activity <<dataclass>> {
    +activity_id: int
    +title: str
    +category: str
    +start_at: str
    +location: str
    +capacity: int
    +policy_type: str
    +has_started(now: str): bool
    +is_direct(): bool
  }
  class Registration <<dataclass>> {
    +id: int
    +activity_id: int
    +student_id: str
    +status: str
    +created_at: str
    +updated_at: str
    +is_active(): bool
    +can_cancel(): bool
  }
  class Message <<dataclass>> {
    +message_id: int
    +student_id: str
    +activity_id: int
    +content: str
    +created_at: str
    +is_read: int
    +dedupe_key: str
  }
  class Email <<new dataclass>> {
    +email_id: int
    +student_id: str
    +activity_id: int
    +registration_id: int
    +to_addr: str
    +subject: str
    +body: str
    +status: str
    +error: str
    +dedupe_key: str
    +created_at: str
  }
}

package "数据访问 repositories" {
  class ActivityRepository {
    +get(activity_id): Activity
    +list(keyword): list
    +create(data): int
    +update(activity_id, data)
    +delete(activity_id)
  }
  class RegistrationRepository {
    +get(registration_id): Registration
    +find_active(activity_id, student_id)
    +count_status(activity_id, status): int
    +count_all(activity_id): int
    +create(activity_id, student_id, status): int
    +update_status(registration_id, status)
    +list_by_student(student_id): list
    +list_pending(): list
  }
  class MessageRepository {
    +add(student_id, activity_id, content, dedupe_key): bool
    +list_by_student(student_id): list
    +unread_count(student_id): int
    +mark_read(message_id)
    +mark_all_read(student_id)
  }
  class StudentRepository <<new>> {
    +get(student_id): Student
  }
  class EmailRepository <<new>> {
    +add(student_id, activity_id, registration_id, to_addr, subject, body, dedupe_key): int
    +mark_sent(email_id)
    +mark_failed(email_id, error)
    +list_by_student(student_id): list
  }
}

package "名额与策略 capacity & policies" {
  class CapacityChecker {
    +approved_count(activity_id): int
    +remaining(activity): int
    +has_room(activity): bool
  }
  class PolicyResult <<dataclass>> {
    +ok: bool
    +status: str
    +code: str
    +message: str
  }
  class PolicyContext <<changed dataclass>> {
    +activity: Activity
    +student: Student
    +student_id: str
    +checker: CapacityChecker
  }
  abstract class RegistrationPolicy {
    +submit(ctx: PolicyContext): PolicyResult
  }
  class DirectRegistrationPolicy
  class ReviewRegistrationPolicy
  class GradeLimitedPolicy <<new>> {
    +submit(ctx: PolicyContext): PolicyResult
    -_grade_denied(ctx: PolicyContext, allowed: tuple): PolicyResult
  }
}

package "事件与通知 events & notifications" {
  class RegistrationEvent <<dataclass>> {
    +type: str
    +registration: Registration
    +activity: Activity
    +student_id: str
  }
  class EventBus {
    +subscribe(event_type, handler)
    +publish(event)
    -_log_failure(event, error)
  }
  class NotificationObserver {
    +handle(event)
  }
  class EmailNotifier <<new>> {
    +handle(event)
    -_dedupe_key(event): str
  }
  class MockEmailSender <<new>> {
    +fail_for: set
    +send(to_addr, subject, body)
  }
}

package "迁移 migrations" {
  class SchemaMigrator <<new>> {
    +current_version(conn): int
    +migrate(conn): int
    -_v2_rebuild_activities(conn)
    -_v2_add_grade(conn)
    -_v2_create_emails(conn)
  }
}

package "应用服务 services" {
  class Result <<dataclass>> {
    +ok: bool
    +code: str
    +message: str
    +errors: dict
    +data: dict
  }
  class RegistrationService <<changed>> {
    +submit(activity_id, student_id): Result
    +approve(registration_id): Result
    +reject(registration_id): Result
    +cancel(registration_id, student_id): Result
  }
  class ActivityService <<changed>> {
    +create(form): Result
    +update(activity_id, form): Result
    +delete(activity_id): Result
    +stats(activity): dict
  }
}

RegistrationPolicy <|-- DirectRegistrationPolicy
RegistrationPolicy <|-- ReviewRegistrationPolicy
DirectRegistrationPolicy <|-- GradeLimitedPolicy
DirectRegistrationPolicy ..> PolicyResult : creates
ReviewRegistrationPolicy ..> PolicyResult : creates
GradeLimitedPolicy ..> PolicyResult : creates
PolicyContext o-- CapacityChecker
PolicyContext o-- Activity
PolicyContext o-- Student

RegistrationService --> ActivityRepository
RegistrationService --> RegistrationRepository
RegistrationService --> StudentRepository
RegistrationService --> RegistrationPolicy : chooses by policy_type
RegistrationService --> CapacityChecker
RegistrationService --> EventBus
ActivityService --> ActivityRepository
ActivityService --> RegistrationRepository

EventBus o-- NotificationObserver
EventBus o-- EmailNotifier
EventBus ..> RegistrationEvent : publishes
NotificationObserver --> MessageRepository
EmailNotifier --> EmailRepository
EmailNotifier --> MockEmailSender

StudentRepository ..> Student
EmailRepository ..> Email
ActivityRepository ..> Activity
RegistrationRepository ..> Registration
MessageRepository ..> Message

SchemaMigrator ..> Email : creates table
SchemaMigrator ..> Student : adds grade column

RegistrationService ..> Result
ActivityService ..> Result
@enduml
